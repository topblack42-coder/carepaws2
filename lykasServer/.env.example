# --- Core ---
NODE_ENV=development
PORT=5000
BACKEND_URL=http://localhost:5000
# Optional: silences dotenv's promotional stdout tip ("tip: ⌘ suppress logs...")
# on every boot. Uncomment if the noise bothers you in local dev/CI logs.
# DOTENV_CONFIG_QUIET=true

# --- Database ---
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/carepaws

# --- Auth ---
JWT_SECRET=replace_with_32plus_char_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_32plus_char_random_string
JWT_REFRESH_EXPIRES_IN=30d

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAX_FILE_SIZE=10485760
# Optional pet introduction video (stored in Cloudinary; MP4/H.264 only)
PET_VIDEO_MAX_SIZE_MB=25
PET_VIDEO_MAX_DURATION_SECONDS=60

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
ANDROID_CLIENT_ID=
IOS_CLIENT_ID=

# --- Email (either transport) ---
EMAIL_SERVICE=
EMAIL_USER=
EMAIL_PASSWORD=


# --- Payments ---
PAYMONGO_SECRET_KEY=
# REQUIRED for any donation/adoption-fee/event-fee payment to ever be
# confirmed - not just "extra signature verification". webhook() in
# paymentController.js rejects every PayMongo webhook event with a hard
# 500 when this is unset, and the webhook is the ONLY code path in this
# app that ever sets a payment's status to "paid". Get this from the
# PayMongo dashboard after creating a webhook endpoint pointed at
# https://<your-public-url>/api/payments/webhook (see SETUP.md).
PAYMONGO_WEBHOOK_SECRET=

# --- Frontends ---
FRONTEND_URL=http://localhost:5173
MOBILE_APP_URL=carepaws://
# Optional. Public base URL of the admin/web build (no trailing slash needed),
# e.g. https://admin.example.com. When set, verification emails also get a
# {{webVerifyUrl}} template variable pointing at <WEB_APP_URL>/verify-email?token=...
# for people who can't open the carepaws:// deep link. Add {{webVerifyUrl}} to
# the verify_email template to show it. Leave unset to keep links mobile-only.
WEB_APP_URL=

# --- Production additions (§11) ---
REDIS_URL=redis://localhost:6379
SENTRY_DSN=
LOG_LEVEL=info
